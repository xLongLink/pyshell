{
    "name": "pyshell-renderer",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5181 --strictPort",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --environment jsdom",
        "format": "prettier --write *.tsx index.css components lib tests index.html package.json tsconfig.json vite.config.ts components.json"
    },
    "dependencies": {
        "@a2ui/react": "0.14.0",
        "@a2ui/web_core": "0.14.0",
        "clsx": "^2.1.1",
        "d3-geo": "^3.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-error-boundary": "6.1.6",
        "recharts": "3.8.0",
        "tailwind-merge": "^3.7.0",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/d3-geo": "^3.1.1",
        "@types/geojson": "^7946.0.16",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^30.1.3",
        "prettier": "^3.8.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "overrides": {
        "dompurify": "3.4.17"
    }
}
