{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "types": ["vite/client", "node"],
        "paths": { "@/*": ["./*"] }
    },
    "include": [
        "*.tsx",
        "components",
        "lib",
        "tests/*.test.ts",
        "tests/*.test.tsx",
        "vite.config.ts"
    ]
}
