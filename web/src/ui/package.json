{
    "name": "pyshell-web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.ts && vitest run tests/*.test.tsx --environment jsdom",
        "format": "prettier --write *.tsx index.css components lib tests/*.{test.ts,test.tsx} index.html package.json tsconfig.json vite.config.ts components.json"
    },
    "dependencies": {
        "@a2ui/react": "0.14.0",
        "@a2ui/web_core": "0.14.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.61.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-error-boundary": "6.1.6",
        "recharts": "3.8.0",
        "tailwind-merge": "^3.7.0",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^30.1.3",
        "prettier": "^3.8.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "overrides": {
        "dompurify": "3.4.17"
    }
}
